# ===== 数据库 =====
# postgresql+asyncpg://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/knowledge_base
# 旧写法也兼容，二选一即可（留空则使用上面的默认值）
#PSQL_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/knowledge_base
# 开发时想看打印的 SQL 就设 True
SQL_ECHO=False

# ===== JWT =====
# 上线前务必换成随机长字符串: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-please-change-me
ALGORITHM=HS256
# token 有效期（分钟），默认 1 天
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 其它 =====
DEBUG=True
API_V1_PREFIX=/api/v1
# 允许调用 /api/v1/user/list 的管理员用户名，逗号分隔
ADMIN_USERNAMES=admin
# 前端地址，逗号分隔；生产环境请收敛成具体域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
