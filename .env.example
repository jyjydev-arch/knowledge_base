# ===== 数据库 =====
# postgresql+asyncpg://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/knowledge_base
# 旧写法也兼容，二选一即可（留空则使用上面的默认值）
#PSQL_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/knowledge_base
# 开发时想看打印的 SQL 就设 True
SQL_ECHO=False

# 启动检查：表不齐是否拒绝启动（生产/Docker 建议 True；默认只告警，/health 如实返 503）
DB_STRICT_STARTUP=False
# 仅开发：启动时自动建表（正式环境请用迁移，别在生产的 PG 上开这个）
AUTO_CREATE_TABLES=False
# 健康检查探库的超时秒数
HEALTH_CHECK_TIMEOUT_SECONDS=2

# ===== JWT =====
# 上线前务必换成随机长字符串: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-please-change-me
ALGORITHM=HS256
# token 有效期（分钟），默认 1 天
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 其它 =====
# 只认 APP_DEBUG（别用裸 DEBUG，容易被 shell/node 工具污染）
APP_DEBUG=True
API_V1_PREFIX=/api/v1
# 允许调用 /api/v1/user/list 的管理员用户名，逗号分隔
ADMIN_USERNAMES=admin
# 前端地址，逗号分隔；生产环境请收敛成具体域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== LLM（对话模型）=====
# 占位值（your_xxx_here / sk-xxxx）会被当成"未配置"，记忆层自动降级成规则式，不会白跑一次网络
# 旧写法 OPENAI_API_KEY / OPENAI_API_BASE_URL 仍然兼容
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ===== Embedding（长期记忆的向量）=====
# 和对话模型通常不是同一家：DeepSeek 没有 embedding 接口
# EMBEDDING_DIMS 一旦建过 collection 就不能改，换模型要连维度带 collection 一起换
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# ===== 文档解析入库（M2 后半）=====
# 上传成功后是否自动丢后台任务去解析切块（关掉就靠 scripts 或 reindex 接口手动触发）
DOCUMENT_INDEX_ON_UPLOAD=True

# ===== 长期记忆 =====
# local    = 本地 JSONL + 词面 hash（开发/测试，不建库不联网就能跑）
# pgvector = 真语义向量（生产，需要 PG 库 + pgvector 扩展 + EMBEDDING_API_KEY）
# off      = 完全不记
MEMORY_BACKEND=local
MEMORY_DIR=data/memory
MEMORY_TOP_K=3
MEMORY_SCORE_THRESHOLD=0.5
MEMORY_DEDUP_THRESHOLD=0.95
MEMORY_MAX_ITEMS_PER_USER=500
MEMORY_AUTO_WRITE=True
MEMORY_EXTRACT_FACTS=True
MEMORY_PG_COLLECTION=long_term_memory
# 文档向量与记忆向量**必须分 collection**（混了会互相命中，清理文档时连带删掉记忆）
DOCUMENT_VECTOR_COLLECTION=kb_documents
VECTOR_INDEX_BATCH_SIZE=64

# ===== 短期记忆（会话上下文窗口）=====
SHORT_TERM_ENABLED=True
SHORT_TERM_MAX_TURNS=6
SHORT_TERM_TOKEN_BUDGET=2000
SHORT_TERM_SUMMARY_MAX_CHARS=400
SHORT_TERM_TTL_SECONDS=14400
SHORT_TERM_MAX_SESSIONS=512
SHORT_TERM_PERSIST=False
SHORT_TERM_USE_TIKTOKEN=False

# ===== 对话（/api/v1/aichat）=====
# 检索总开关：关掉后问答照样能跑，只是不带【参考资料】（对比"凭资料答"和"凭记忆答"时用）
CHAT_RETRIEVAL_ENABLED=True
# 进 prompt 的资料块数 / 资料总长上限 / 单块截断长度
# 上限存在的理由：一个 8k 字的块会把上下文窗口整个吃掉，模型反而看不见用户的问题
CHAT_RETRIEVAL_TOP_K=4
CHAT_RETRIEVAL_MAX_CHARS=4000
CHAT_SNIPPET_CHARS=320
# SSE 心跳秒数（0=不发）。手机切后台、nginx 空闲 30~60s 就会掐连接，靠心跳续命
CHAT_STREAM_HEARTBEAT_SECONDS=15
# 首轮问答用问题前缀自动命名会话时截多少字
CHAT_AUTO_TITLE_CHARS=30
# 僵尸生成键的存活时间：上一路流被硬杀且没走到 finally 时，超过这个秒数才允许被新请求顶掉
CHAT_STALE_GENERATION_SECONDS=600
